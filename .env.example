# Copy to .env and fill in what you have.

# --- required ---
# Jev, the classifier this demo is built around. It's a paid API; get a key at
# https://console.typesafe.ai/settings/keys. Without one every message gets an error reply.
TYPESAFE_API_KEY=

# --- optional: behaviour ---
# Jev model. Defaults to jev-latest when unset or blank.
TYPESAFE_MODEL=

# --- optional: ports and storage ---
# The API server's port and the web dev server's port; both the server and Vite read these.
PORT=8787
WEB_PORT=5173
# SQLite file, relative to apps/server.
DATABASE_PATH=./jev-chat.db
